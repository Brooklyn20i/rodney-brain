# The Timekeeper's Exchange — environment template
#
# The MVP runs entirely on a mocked, browser-persisted data layer and requires
# NO environment variables to run. The variables below document the production
# integration points the architecture is designed for. Each mocked provider has
# a documented interface in src/lib/ — see docs/mocked-integrations.md.

# --- Backend (Supabase / Postgres) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only (never expose to the client):
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://user:pass@host:5432/timekeepers

# --- Payments (Stripe Connect — AU) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Identity / KYC (Stripe Identity, Persona, or FrankieOne) ---
KYC_PROVIDER=            # stripe_identity | persona | frankieone
KYC_API_KEY=

# --- Logistics (insured couriers) ---
LOGISTICS_PROVIDER=      # auspost | dhl | fedex | malca_amit
LOGISTICS_API_KEY=

# --- Notifications ---
EMAIL_PROVIDER=          # resend | ses | postmark
EMAIL_API_KEY=
SMS_PROVIDER=            # twilio (architecture is SMS-ready; not used in MVP)
SMS_API_KEY=

# --- Object storage (signed URLs only; no public buckets) ---
STORAGE_BUCKET=
STORAGE_SIGNING_SECRET=
